    <!-- legs + waist yaw: 6512 cycloidal actuators, torque control, peak 23.1 N.m -->
    <motor name="left_hip_pitch" joint="left_hip_pitch_joint" ctrlrange="-23.1 23.1"/>
    <motor name="left_hip_roll" joint="left_hip_roll_joint" ctrlrange="-23.1 23.1"/>
    <motor name="left_hip_yaw" joint="left_hip_yaw_joint" ctrlrange="-23.1 23.1"/>
    <motor name="left_knee" joint="left_knee_joint" ctrlrange="-23.1 23.1"/>
    <motor name="right_hip_pitch" joint="right_hip_pitch_joint" ctrlrange="-23.1 23.1"/>
    <motor name="right_hip_roll" joint="right_hip_roll_joint" ctrlrange="-23.1 23.1"/>
    <motor name="right_hip_yaw" joint="right_hip_yaw_joint" ctrlrange="-23.1 23.1"/>
    <motor name="right_knee" joint="right_knee_joint" ctrlrange="-23.1 23.1"/>
    <motor name="waist_yaw" joint="waist_yaw_joint" ctrlrange="-23.1 23.1"/>
    <!-- ankles: the two shin actuators of each leg, through the crank-and-rod linkage (tendons above) -->
    <motor name="left_ankle_A" tendon="left_ankle_A" ctrlrange="-23.1 23.1"/>
    <motor name="left_ankle_B" tendon="left_ankle_B" ctrlrange="-23.1 23.1"/>
    <motor name="right_ankle_A" tendon="right_ankle_A" ctrlrange="-23.1 23.1"/>
    <motor name="right_ankle_B" tendon="right_ankle_B" ctrlrange="-23.1 23.1"/>
